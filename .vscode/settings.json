{
  "explorer.excludeGitIgnore": false,
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.extraPaths": ["${workspaceFolder}/dags", "${workspaceFolder}/plugins"],
  "python.analysis.packageIndexDepths": [
    { "name": "airflow", "depth": 2, "includeAllSymbols": true },
    { "name": "airflow.providers", "depth": 4, "includeAllSymbols": true }
  ],
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "jupyter.notebookFileRoot": "${workspaceFolder}",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "terminal.integrated.env.linux": {
    "PYTHONPATH": "${workspaceFolder}/dags:${workspaceFolder}/plugins"
  },
  "cursorpyright.analysis.extraPaths": [
    "${workspaceFolder}/dags",
    "${workspaceFolder}/plugins"
  ],
  "cursorpyright.analysis.packageIndexDepths": [
    { "name": "airflow", "depth": 2, "includeAllSymbols": true },
    { "name": "airflow.providers", "depth": 4, "includeAllSymbols": true }
  ]
}
